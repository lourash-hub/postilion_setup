; Patch configuration — generated by Ansible, read by postilion_patch.exe
[patch]
name={{ patch_current_name }}
log_file={{ patch_log_file }}

[timeouts]
screen_wait={{ postilion_patch_screen_wait | default(2000) }}
popup_wait={{ postilion_patch_popup_wait | default(3) }}
progress_timeout={{ postilion_patch_progress_timeout | default(600) }}
screen_timeout=60
