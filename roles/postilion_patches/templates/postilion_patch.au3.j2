; =============================================================================
; Postilion Realtime Framework — Patch AutoIt GUI Automation
; Generated by Ansible Jinja2 template
; =============================================================================
; DO NOT EDIT THIS FILE DIRECTLY — it is generated from postilion_patch.au3.j2
;
; Patch wizard flow:
;   Screen 1: Welcome        → Click Next >
;   Screen 2: Ready to Install → Click Next > (may trigger Event Viewer popup)
;   Screen 3: Install in progress → Wait for completion
;   Screen 4: Installation Complete → Click Finish
; =============================================================================

#include <MsgBoxConstants.au3>
#include <StringConstants.au3>

; === Configuration (injected by Ansible/Jinja2) ===
Local $patchName = "{{ patch_current_name }}"

; === Timeouts ===
Local $screenWait = {{ postilion_patch_screen_wait | default(2000) }}
Local $popupWait = {{ postilion_patch_popup_wait | default(3) }}
Local $progressTimeout = {{ postilion_patch_progress_timeout | default(600) }}
Local $screenTimeout = 60

; === Logging ===
Local $logFile = "{{ patch_log_file }}"

; === Window titles ===
Local $mainWindow = "Realtime Install Framework"
Local $popupEventViewer = "Event Viewer"

; === Exit codes ===
Local Const $EXIT_SUCCESS = 0
Local Const $EXIT_TIMEOUT = 1
Local Const $EXIT_UNEXPECTED = 2
Local Const $EXIT_CONTROL_NOT_FOUND = 3
Local Const $EXIT_FATAL = 99

; =============================================================================
; Logging function
; =============================================================================
Func _Log($msg)
    Local $timestamp = @YEAR & "-" & @MON & "-" & @MDAY & " " & @HOUR & ":" & @MIN & ":" & @SEC
    Local $logLine = $timestamp & " | " & $msg
    ConsoleWrite($logLine & @CRLF)
    FileWriteLine($logFile, $logLine)
EndFunc

; =============================================================================
; Screen handler — waits for a screen and validates it appeared
; =============================================================================
Func _HandleScreen($screenName, $expectedText, $timeout = 0)
    If $timeout = 0 Then $timeout = $screenTimeout
    _Log("Waiting for screen: " & $screenName & " (timeout: " & $timeout & "s)")

    Local $result = WinWaitActive($mainWindow, $expectedText, $timeout)
    If $result = 0 Then
        _Log("ERROR: Timeout waiting for screen: " & $screenName)
        _Log("Expected text: " & $expectedText)
        Exit $EXIT_TIMEOUT
    EndIf

    _Log("Screen found: " & $screenName)
    Sleep($screenWait)
    Return $result
EndFunc

; =============================================================================
; Conditional popup handler — Event Viewer
; =============================================================================
Func _HandlePopup($title, $buttonText, $waitTime = 0)
    If $waitTime = 0 Then $waitTime = $popupWait
    _Log("Checking for popup: " & $title & " (wait: " & $waitTime & "s)")

    Sleep($waitTime * 1000)
    If WinExists($title) Then
        _Log("Popup detected: " & $title)
        WinActivate($title)
        Sleep(500)

        ; Strategy 1: Exact text
        Local $clickResult = ControlClick($title, "", "[TEXT:" & $buttonText & "]")
        If $clickResult = 1 Then
            _Log("Popup button clicked via [TEXT:" & $buttonText & "]")
            Sleep(1000)
            Return True
        EndIf

        ; Strategy 2: With & accelerator
        $clickResult = ControlClick($title, "", "[TEXT:&" & $buttonText & "]")
        If $clickResult = 1 Then
            _Log("Popup button clicked via [TEXT:&" & $buttonText & "]")
            Sleep(1000)
            Return True
        EndIf

        ; Strategy 3: CLASS:Button + text
        $clickResult = ControlClick($title, "", "[CLASS:Button; TEXT:" & $buttonText & "]")
        If $clickResult = 1 Then
            _Log("Popup button clicked via [CLASS:Button; TEXT:" & $buttonText & "]")
            Sleep(1000)
            Return True
        EndIf

        ; Strategy 4: Scan buttons for matching text
        For $i = 1 To 6
            Local $btnText = ControlGetText($title, "", "[CLASS:Button; INSTANCE:" & $i & "]")
            If @error Then ExitLoop
            _Log("  Popup button INSTANCE:" & $i & " text='" & $btnText & "'")
            If StringInStr($btnText, $buttonText) Then
                $clickResult = ControlClick($title, "", "[CLASS:Button; INSTANCE:" & $i & "]")
                If $clickResult = 1 Then
                    _Log("Popup button clicked via INSTANCE:" & $i)
                    Sleep(1000)
                    Return True
                EndIf
            EndIf
        Next

        ; Strategy 5: Keyboard fallback
        _Log("WARNING: All ControlClick failed on popup, trying Enter key")
        Send("{ENTER}")
        Sleep(1000)
        _Log("Popup handled via Enter key: " & $title)
        Return True
    EndIf

    _Log("Popup not detected: " & $title)
    Return False
EndFunc

; =============================================================================
; Click Next button — robust multi-strategy approach
; =============================================================================
Func _ClickNext()
    _Log("Clicking Next >")

    ; Strategy 1: Exact text match
    Local $result = ControlClick($mainWindow, "", "[TEXT:Next >]")
    If $result = 1 Then
        _Log("Next clicked via [TEXT:Next >]")
        Sleep($screenWait)
        Return
    EndIf

    ; Strategy 2: With & accelerator key
    $result = ControlClick($mainWindow, "", "[TEXT:&Next >]")
    If $result = 1 Then
        _Log("Next clicked via [TEXT:&Next >]")
        Sleep($screenWait)
        Return
    EndIf

    ; Strategy 3: Class + text
    $result = ControlClick($mainWindow, "", "[CLASS:Button; TEXT:Next >]")
    If $result = 1 Then
        _Log("Next clicked via [CLASS:Button; TEXT:Next >]")
        Sleep($screenWait)
        Return
    EndIf

    ; Strategy 4: Scan all Button instances for one containing "Next"
    For $i = 1 To 10
        Local $btnText = ControlGetText($mainWindow, "", "[CLASS:Button; INSTANCE:" & $i & "]")
        If @error Then ExitLoop
        _Log("  Button INSTANCE:" & $i & " text='" & $btnText & "'")
        If StringInStr($btnText, "Next") Then
            $result = ControlClick($mainWindow, "", "[CLASS:Button; INSTANCE:" & $i & "]")
            If $result = 1 Then
                _Log("Next clicked via [CLASS:Button; INSTANCE:" & $i & "]")
                Sleep($screenWait)
                Return
            EndIf
        EndIf
    Next

    ; Strategy 5: Keyboard shortcut Alt+N
    _Log("WARNING: All ControlClick strategies failed, trying keyboard Alt+N")
    Send("!n")
    Sleep($screenWait)

    ; Strategy 6: Last resort — press Enter
    _Log("WARNING: Trying Enter key as last resort")
    Send("{ENTER}")
    Sleep($screenWait)

    _Log("WARNING: Next button click used keyboard fallback — verify screen advanced")
EndFunc

; =============================================================================
; Click Finish button — robust multi-strategy approach
; =============================================================================
Func _ClickFinish()
    _Log("Clicking Finish")

    ; Strategy 1: Exact text match
    Local $result = ControlClick($mainWindow, "", "[TEXT:Finish]")
    If $result = 1 Then
        _Log("Finish clicked via [TEXT:Finish]")
        Sleep($screenWait)
        Return
    EndIf

    ; Strategy 2: With & accelerator
    $result = ControlClick($mainWindow, "", "[TEXT:&Finish]")
    If $result = 1 Then
        _Log("Finish clicked via [TEXT:&Finish]")
        Sleep($screenWait)
        Return
    EndIf

    ; Strategy 3: Class + text
    $result = ControlClick($mainWindow, "", "[CLASS:Button; TEXT:Finish]")
    If $result = 1 Then
        _Log("Finish clicked via [CLASS:Button; TEXT:Finish]")
        Sleep($screenWait)
        Return
    EndIf

    ; Strategy 4: Scan buttons
    For $i = 1 To 10
        Local $btnText = ControlGetText($mainWindow, "", "[CLASS:Button; INSTANCE:" & $i & "]")
        If @error Then ExitLoop
        _Log("  Button INSTANCE:" & $i & " text='" & $btnText & "'")
        If StringInStr($btnText, "Finish") Then
            $result = ControlClick($mainWindow, "", "[CLASS:Button; INSTANCE:" & $i & "]")
            If $result = 1 Then
                _Log("Finish clicked via [CLASS:Button; INSTANCE:" & $i & "]")
                Sleep($screenWait)
                Return
            EndIf
        EndIf
    Next

    ; Strategy 5: Keyboard fallback
    _Log("WARNING: All ControlClick strategies failed for Finish, trying Enter key")
    Send("{ENTER}")
    Sleep($screenWait)
EndFunc

; =============================================================================
; MAIN — Patch Installation Flow
; =============================================================================
_Log("=============================================================================")
_Log("Postilion Patch AutoIt Automation Starting")
_Log("Patch: " & $patchName)
_Log("=============================================================================")

; --- Screen 1: Welcome ---
_HandleScreen("Welcome", "Welcome to the Installation Wizard", 120)
_Log("SCREEN 1: Welcome screen detected")
_ClickNext()

; --- Event Viewer popup (may appear after clicking Next on Screen 1 or Screen 2) ---
_HandlePopup($popupEventViewer, "OK", $popupWait)

; --- Screen 2: Ready to Install ---
_HandleScreen("Ready to Install", "Ready to Install", $screenTimeout)
_Log("SCREEN 2: Ready to Install screen detected")
_ClickNext()

; --- Event Viewer popup (commonly appears after Ready to Install) ---
_HandlePopup($popupEventViewer, "OK", $popupWait)

; --- Screen 3: Install in progress — wait for completion ---
_Log("SCREEN 3: Waiting for installation to complete (timeout: " & $progressTimeout & "s)")

; Wait for the progress screen to appear
_HandleScreen("Install in progress", "Install in progress", $screenTimeout)

; Now wait for the Installation Complete screen (progress bar running)
Local $progressResult = WinWaitActive($mainWindow, "Installation Complete", $progressTimeout)
If $progressResult = 0 Then
    _Log("ERROR: Timeout waiting for installation to complete after " & $progressTimeout & "s")
    Exit $EXIT_TIMEOUT
EndIf

; --- Screen 4: Installation Complete ---
_Log("SCREEN 4: Installation Complete screen detected")
Sleep($screenWait)
_ClickFinish()

; --- Done ---
_Log("=============================================================================")
_Log("Patch " & $patchName & " installed successfully")
_Log("=============================================================================")

Exit $EXIT_SUCCESS
