# =============================================================================
# install_patch.ps1 — Install a single Postilion patch using PatchInstaller
# Generated by Ansible template — do not edit manually
# =============================================================================
param(
    [Parameter(Mandatory=$true)]
    [string]$PatchPath,

    [Parameter(Mandatory=$true)]
    [string]$PatchInstaller,

    [Parameter(Mandatory=$true)]
    [string]$ResponseFile,

    [Parameter(Mandatory=$true)]
    [string]$LogDir,

    [Parameter(Mandatory=$true)]
    [string]$TempDir
)

$patchName = Split-Path $PatchPath -Leaf
$patchDir = Split-Path $PatchPath -Parent
$patchBaseName = $patchName -replace '\.exe$', ''
$logFile = Join-Path $LogDir ("patch_" + $patchBaseName + ".log")
$errorLogFile = Join-Path $LogDir ("patch_error_" + $patchBaseName + ".log")

Write-Output "=============================================="
Write-Output "Installing patch: $patchName"
Write-Output "Patch directory:  $patchDir"
Write-Output "Log file:         $logFile"
Write-Output "=============================================="

# Update the response file to point to this patch's directory
$responseContent = Get-Content $ResponseFile -Raw
$pattern = 'value="[^"]*"(\s*/>)'
$replacement = 'value="' + $patchDir + '"$1'
$updatedResponse = [regex]::Replace($responseContent, $pattern, $replacement)

# Write a per-patch response file
$perPatchResponse = Join-Path $TempDir "response_patch_current.xml"
Set-Content -Path $perPatchResponse -Value $updatedResponse

# Run PatchInstaller
$process = Start-Process -FilePath $PatchInstaller `
    -ArgumentList "-response", $perPatchResponse `
    -Wait -PassThru -NoNewWindow `
    -RedirectStandardOutput $logFile `
    -RedirectStandardError $errorLogFile

Write-Output "Exit code: $($process.ExitCode)"

if (Test-Path $logFile) {
    Write-Output "--- Log tail ---"
    Get-Content $logFile -Tail 15
    Write-Output "--- End log ---"
}

if ($process.ExitCode -ne 0) {
    Write-Error "Patch $patchName failed with exit code: $($process.ExitCode)"
    exit $process.ExitCode
}

Write-Output "Patch $patchName installed successfully."
