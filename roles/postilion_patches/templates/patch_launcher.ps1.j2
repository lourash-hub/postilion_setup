# =============================================================================
# Postilion Patch — Interactive session launcher
# Generated by Ansible template — do not edit manually
#
# Runs in the interactive desktop session via scheduled task.
# Starts setup.exe, waits for the GUI window, then launches AutoIt.
# =============================================================================
$logFile = "{{ patch_log_file }}"
$ErrorActionPreference = "Continue"

Add-Content -Path $logFile -Value "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') [LAUNCHER] Starting patch: {{ patch_current_name }}"
Add-Content -Path $logFile -Value "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') [LAUNCHER] Setup exe: {{ patch_setup_exe }}"

# Start the patch installer GUI
$installer = Start-Process -FilePath "{{ patch_setup_exe }}" -PassThru
Add-Content -Path $logFile -Value "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') [LAUNCHER] Installer started PID=$($installer.Id)"

# Wait for the installer window to appear (up to 120 seconds)
$timeout = 120
$elapsed = 0
$windowFound = $false
while ($elapsed -lt $timeout) {
    Start-Sleep -Seconds 3
    $elapsed += 3
    # Check for the window
    $procs = Get-Process | Where-Object {
        $_.MainWindowTitle -eq "Realtime Install Framework"
    }
    if (-not $procs) {
        # Fallback: substring match
        $procs = Get-Process | Where-Object {
            $_.MainWindowTitle -like "*Realtime Install*" -and
            $_.ProcessName -ne "notepad" -and
            $_.ProcessName -ne "notepad++"
        }
    }
    if ($procs) {
        $windowFound = $true
        Add-Content -Path $logFile -Value "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') [LAUNCHER] Installer window detected: $($procs[0].MainWindowTitle) (PID=$($procs[0].Id)) after ${elapsed}s"
        break
    }
}

if (-not $windowFound) {
    Add-Content -Path $logFile -Value "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') [LAUNCHER] WARNING: Window not detected after ${timeout}s, proceeding with AutoIt anyway"
}

# Small delay to let the window fully render
Start-Sleep -Seconds 5

# Launch AutoIt automation
{% if patch_autoit_use_interpreter | default(false) %}
$autoitExe = "{{ temp_dir }}\AutoIt3.exe"
$autoitArg = "{{ temp_dir }}\postilion_patch.au3"
Add-Content -Path $logFile -Value "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') [LAUNCHER] Starting AutoIt: $autoitExe $autoitArg"
$autoit = Start-Process -FilePath $autoitExe -ArgumentList $autoitArg -Wait -PassThru
{% else %}
Add-Content -Path $logFile -Value "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') [LAUNCHER] ERROR: AutoIt3.exe interpreter not available"
$autoit = $null
{% endif %}

if ($autoit) {
    Add-Content -Path $logFile -Value "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') [LAUNCHER] AutoIt finished with exit code: $($autoit.ExitCode)"
    $autoit.ExitCode | Out-File -FilePath "{{ temp_dir }}\patch_autoit_exitcode.txt" -NoNewline
} else {
    Add-Content -Path $logFile -Value "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') [LAUNCHER] ERROR: AutoIt did not run"
    "99" | Out-File -FilePath "{{ temp_dir }}\patch_autoit_exitcode.txt" -NoNewline
}
